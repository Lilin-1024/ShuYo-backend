[Unit]
Description=ShuYo online backup (no service downtime)
After=docker.service

[Service]
Type=oneshot
SuccessExitStatus=75
User=root
WorkingDirectory=/opt/ShuYo-backend
ExecStart=/usr/bin/python3 /opt/ShuYo-backend/scripts/backup-online.py --reason scheduled --require-running
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=256M
TimeoutStartSec=15min
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ShuYo-backend/backups
