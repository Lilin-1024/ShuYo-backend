# Copy to .env, then replace all change-me values before deploying.
# Keep .env private and transfer it separately when moving to a new server.
SITE_DOMAIN=shuyo.work
API_DOMAIN=api.shuyo.work
PORT=3000
COOKIE_SECURE=true
# Admin accounts are created with scripts/admin-cli.js and stored in data/admins.sqlite.
COOKIE_SECRET=change-me
PRESENCE_HMAC_SECRET=change-me
STUDENT_ID_HMAC_SECRET=change-me
STUDENT_ID_ENCRYPTION_KEY=change-me
SHARE_DATA_KEY=change-me
SESSION_TTL_HOURS=168
APP_NAME=ShuYo
DEFAULT_VERSION=0.1.0
DEFAULT_BUILD=1
DEFAULT_UPDATE_TITLE=发现新版本
DEFAULT_UPDATE_MESSAGE=
DEFAULT_DOWNLOAD_URL=https://download.shuyo.work/latest.apk
DEFAULT_NOTICE_TEXT=
